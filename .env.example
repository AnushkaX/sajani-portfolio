# Admin: set a secret password to access /admin. Required for admin login.
ADMIN_SECRET=your-secret-password

# Required for Vercel. Optional locally — without these, projects are stored in data/projects.json.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: override site content via env (defaults used if not set)
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/yourhandle
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/in/yourprofile
# NEXT_PUBLIC_SOCIAL_BEHANCE=https://behance.net/yourprofile
# NEXT_PUBLIC_IMAGE_HERO=/images/project1/1.jpg
# NEXT_PUBLIC_IMAGE_ABOUT=/images/project1/2.jpg
# NEXT_PUBLIC_CV_URL=/cv.pdf
# NEXT_PUBLIC_CV_DOWNLOAD_NAME=Your_Name_CV.pdf
